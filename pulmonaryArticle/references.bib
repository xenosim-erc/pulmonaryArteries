@article{yangEvolutionHemodynamicForces2019,
  title = {Evolution of Hemodynamic Forces in the Pulmonary Tree with Progressively Worsening Pulmonary Arterial Hypertension in Pediatric Patients},
  author = {Yang, Weiguang and Dong, Melody and Rabinovitch, Marlene and Chan, Frandics P. and Marsden, Alison L. and Feinstein, Jeffrey A.},
  year = 2019,
  month = jun,
  journal = {Biomechanics and Modeling in Mechanobiology},
  volume = {18},
  number = {3},
  pages = {779--796},
  issn = {1617-7940},
  doi = {10.1007/s10237-018-01114-0},
  urldate = {2026-03-30},
  abstract = {Pulmonary arterial hypertension (PAH) is characterized by pulmonary vascular remodeling resulting in right ventricular (RV) dysfunction and ultimately RV failure. Mechanical stimuli acting on the vessel walls of the full pulmonary tree have not previously been comprehensively characterized. The goal of this study is to characterize wall shear stress (WSS) and strain in pediatric PAH patients at different stages of disease severity using computational patient-specific modeling. Computed tomography, magnetic resonance imaging and right heart catheterization data were collected and assimilated into pulmonary artery (PA) models for patients with and without PAH. Patients were grouped in three disease severity groups (control, moderate and severe) based on clinical evaluations. A finite element solver was employed to quantify hemodynamics and wall strains. To estimate WSS in the distal small PAs with diameters ranging from 50 to 500~\$\$\textbackslash upmu \textbackslash text \textbraceleft m\textbraceright\$\$, a morphometric tree model was created, with inputs coming from outlets of the 3D model. WSS in the proximal PAs decreased with disease severity (control 20.5 vs. moderate 15.8 vs. severe 6.3~\$\$\textbackslash text \textbraceleft dyn\textbraceright/\textbackslash text \textbraceleft cm\textbraceright\textasciicircum 2\$\$, \$\$p{$<$}0.05\$\$). Oscillatory shear index increased in the main pulmonary artery (MPA) with disease severity (0.13 vs. 0.13 vs. 0.2, \$\$p{$>$}0.05\$\$). Wall strains measured by the first invariant of Green strain tensor decreased with disease severity (0.16 vs. 0.12 vs. 0.11, \$\$p{$>$}0.05\$\$). Mean WSS for the distal PAs between 100 and 500~\$\$\textbackslash upmu \textbackslash text \textbraceleft m\textbraceright\$\$significantly increased with disease severity (20 vs. 52 vs. 116 \$\$\textbackslash text \textbraceleft dyn\textbraceright/\textbackslash text \textbraceleft cm\textbraceright\textasciicircum 2\$\$, \$\$p{$<$}0.05\$\$). In conclusion, 3D flow simulations showed that WSS is significantly decreased in the MPA with disease while the mathematical morphometric model suggested increased WSS in the distal small vessels. Computational models can reveal mechanical stimuli acting on vessel walls that may inform patient risk stratification and flow shear experiments.},
  langid = {english},
  keywords = {Blood flow simulation,Distal pulmonary artery,Morphometry tree,Oscillatory shear index,Patient-specific modeling,Pulmonary arterial hypertension,Wall shear stress,Wall strain},
  file = {C:\Users\Conor Moore\Zotero\storage\T5N9S2DM\Yang et al. - 2019 - Evolution of hemodynamic forces in the pulmonary tree with progressively worsening pulmonary arteria.pdf}
}

