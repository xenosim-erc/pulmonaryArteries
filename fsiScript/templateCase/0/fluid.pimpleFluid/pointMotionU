FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointMotionU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
  processor
    {
      type processor;
    }
  
    // The wall is driven by the FSI coupling, and these patches share their rim
    // points with it. Holding them at fixedValue pins the interior of each
    // outlet plane while its rim is dragged by the moving wall, which shears the
    // adjacent cells. slip lets the points slide within their own plane instead,
    // matching what the solid already does for pointD. It relies on the patches
    // being planar, which the flow extensions guarantee.
    "auto.*"
    {
        type         slip;
        value        uniform (0 0 0);
    }
    inlet
    {
        type         slip;
        value        uniform (0 0 0);
    }
    "wall.*"
    {
        type         fixedValue;
        value        uniform (0 0 0);
    }
}

