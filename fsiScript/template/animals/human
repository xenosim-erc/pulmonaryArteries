# Default parameters for human geometries, read by meshing.sh when
# --animal human is chosen. One "name value" pair per line; anything after
# '#' is ignored. Each value can be overridden on the meshing.sh command line
# with the option named beside it.

# Inlet waveform in constant/fluid/inletFlow of the case templates
inletFlow           humanFlow   #            --inlet-flow

# Arterial wall (constant/solid/mechanicalProperties): the isotropic Fung law
#     W = 0.5 c (exp(a tr(Ebar & Ebar)) - 1) + U(J)
# as in the solids4foam pulmonaryArteries tutorial. c and a are that tutorial's
# fit, under plane stress and incompressibility, to the planar biaxial
# (membrane) Fung fit of human pulmonary artery of Azadani et al. (2012),
# J Heart Valve Dis 21:527 (c = 15 kPa, ctt = czz = 6, ctz = 1.8): stretch
# ratios 1:1, 1:0.75 and 0.75:1 up to 1.3, RMS stress error under 1%. The
# small-strain shear modulus is c a / 2 = 27.7 kPa. The bulk modulus is a
# near-incompressibility penalty (small-strain Poisson's ratio about 0.486).
wallModel           isotropicFungElastic #   --wall-model
wallDensity         1200        # kg/m^3     --wall-density
wallFungC           7.87e3      # Pa         --wall-fung-c
wallFungA           7.05        # -          --wall-fung-a
wallBulkModulus     1e6         # Pa         --wall-bulk-modulus

# Three-element Windkessel totals for the whole pulmonary bed, healthy
# volunteers of Lungu et al. (2014), J Biomech 47:2941,
# doi:10.1016/j.jbiomech.2014.07.024. Lungu gives Rp and Rd only as bar charts
# (Fig. 4), so those two are read off the chart; C is the value in the text,
# 4.19 mL/mmHg. C is for the whole bed: when the case runs, the compliance of
# the 3D wall is measured and taken off C (see compliancePressureStep).
wkProximalResistance 3.3e6      # Pa s/m^3   --wk-proximal-resistance
wkDistalResistance   2e7        # Pa s/m^3   --wk-distal-resistance
wkCompliance         3.14e-8    # m^3/Pa     --wk-compliance

# Pressure at the time of imaging: the prestress load, and the initial fluid
# and Windkessel pressure of the fluid-solid interaction run. Taken as the
# diastolic pressure, an assumption within the healthy resting range of
# 4-12 mmHg (normal ranges in the ERS practical recommendations on right heart
# catheterisation parameters).
prestressPressure   10          # mmHg       --prestress-pressure

# Load steps of the first prestress pass, which ramps the pressure up from
# zero on the scanned geometry. Only 2 and 5 may be factors (4, 5, 8, 10, ...)
prestressRampSteps  4           #            --prestress-ramp-steps

# Pressure step over which the 3D wall compliance is measured, from the
# imaging (diastolic) pressure up: a pulse pressure, so the result is the
# secant compliance over the pulse like the whole-bed value. 10 + 12 = 22 mmHg
# systolic, within the healthy resting range of 15-25 mmHg (same source).
compliancePressureStep 12       # mmHg       --compliance-pressure-step

# Set to "yes" while any value above is a placeholder rather than a value
# chosen for this animal; meshing.sh then warns
placeholder         no
