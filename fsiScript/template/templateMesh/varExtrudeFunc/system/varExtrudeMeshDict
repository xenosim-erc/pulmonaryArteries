FoamFile
{
    format      ascii;
    class       dictionary;
    object      varExtrudeMeshDict;
}

// Generate a separate solid wall mesh from the actual fluid wall patch.
// Since layer 0 is copied exactly, the resulting inner solid boundary is
// conformal with the fluid wall boundary.
constructFrom       patch;
sourceCase          "../fluidMeshing";
sourcePatches       (wall);

// Stock patch-mode extrusion requires this to be an existing source patch.
// It supplies patch information for the exposed surface in the new mesh.
exposedPatchName    outerWall;

// Point field in fluidExtrudeTest/0. It must be a pointScalarField with
// dimensions of length. Each wall point value is its total extrusion depth.
distanceField       WallThickness;

// Fluid boundary normals normally point outward into the arterial wall.
flipNormals         false;

// Smooth the extrusion directions before extruding. Each point is extruded
// along its own normal, so wherever the wall is concave on the outside with a
// radius below the local thickness, neighbouring normals cross and cells fold
// inside out. Adaptive smoothing finds the faces that would fold and smooths
// the normals only around them, widening the region until none would; the
// rest of the wall keeps its own normals. It adapts to the thickness by
// itself. Across 94 test geometries (fold model) it matched 20 uniform passes
// at 5% extrusion while touching 1% of the wall, and at 10% cut the
// geometries that would fold from 27 to 8 against 80 uniform passes.
// nNormalSmoothingIterations adds uniform passes first (meshing.sh:
// --normal-smoothing-passes). maxNormalTilt stops any normal turning more
// than 45 degrees from the wall normal.
nNormalSmoothingIterations 0;
adaptiveNormalSmoothing yes;
adaptiveFoldMargin  0.25;   // flag faces whose outer face shrinks below this
adaptiveInitialRings 2;     // smoothed region around them, in point rings
adaptiveRingGrowthInterval 10;  // widen it by a ring every so many rounds
adaptiveMaxRings    40;
adaptiveMaxIterations 300;
maxNormalTilt       45;

// The private utility uses this model for nLayers and sumThickness(), but
// replaces its constant geometric thickness with distanceField at each point.
extrudeModel        linearNormal;
nLayers             3;
expansionRatio      1.0;

linearNormalCoeffs
{
    // Required by linearNormal's constructor but ignored as the total
    // distance: WallThickness supplies the actual pointwise distance.
    thickness       1;
}

mergeFaces          false;
mergeTol            0;
