FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
libs            ("libwindkesselPressure.so");

application     pimpleFoam;

startFrom       latestTime;//startTime;//latestTime;//startTime;

startTime       0;

stopAt          endTime;

endTime         1.72;

deltaT          5e-5;

writeControl    runTime;

writeInterval   0.02;

adjustTimeStep yes;
maxCo          15;
maxDeltaT      2e-3;


purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

fileHandler uncollated;

