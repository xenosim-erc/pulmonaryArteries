#!/bin/bash
#------------------------------------------------------------------------------
# Compute the prestress Fpre of the imaged arterial wall
#
# The imaged geometry is loaded by the blood pressure at the time of imaging,
# so it is not stress-free. This solid-only case applies that pressure to
# innerWall and repeats a modified updated Lagrangian (MULF) pass until the
# imaged wall is in equilibrium with it:
#
#   1. solids4Foam runs a steady-state solve under the pressure;
#   2. updatePrestress composes the deformation gradient of that run with the
#      Fpre it used, Fpre <- F & Fpre, writes it to 0/Fpre and removes the
#      later time directories, so the next pass starts again from the imaged
#      geometry with zero displacement.
#
# Every pass is a single load step. The pressure ramps up across the passes,
# by pressureStep per pass, until it reaches targetPressure: pass k applies
# min(k pressureStep, targetPressure). Pass 1 runs with "prestress no" on the
# stress-free imaged wall; later passes run with "prestress yes", so each
# solve only adds the pressure step to a wall already balanced by Fpre at the
# previous pressure. The pressure never falls, so the prestressed wall is
# never deflated, which the solver does not converge through.
#
# Once the pressure is at targetPressure, passes continue until the maximum
# displacement of a run, maxMag(D) in prestressHistory, is below the
# tolerance, or after maxPasses passes at that pressure. meshing.sh sets all
# four below.
# The final Fpre is copied to ../0/solid/Fpre for the fluid-solid interaction
# run, which uses the same material: constant/mechanicalProperties is copied
# from ../constant/solid/mechanicalProperties, and the solid mesh from
# ../constant/solid/polyMesh, at the start of every run.
#
# Usage:
#   ./Allrun           # run in parallel, numberOfSubdomains in
#                      # system/decomposeParDict
#   ./Allrun serial    # run in serial
#------------------------------------------------------------------------------

set -Eeo pipefail
IFS=$'\n\t'

cd "$(cd "$(dirname "$0")" && pwd)"

: "${WM_PROJECT_DIR:?OpenFOAM environment is not sourced}"

source solids4FoamScripts.sh

# Stop when maxMag(D) of a run is below this, in metres (set by meshing.sh)
tolerance=1e-5

# Give up after this many passes at the full pressure (set by meshing.sh)
maxPasses=30

# Imaging pressure on innerWall, and the rise per pass of the ramp up to it,
# in Pa (set by meshing.sh)
targetPressure=1333.22
pressureStep=133.322

runParallel=yes

for arg in "$@"
do
    case "$arg" in
        serial)
            runParallel=no
            ;;
        parallel)
            runParallel=yes
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Usage: ./Allrun [serial|parallel]" >&2
            exit 1
            ;;
    esac
done

solids4Foam::requirePetscOrExitSilently
solids4Foam::caseDoesNotRunWithFoamExtend

# The wall material and mesh are defined once, in the fluid-solid interaction
# case, so that Fpre is computed for exactly what that run solves
materialFile=../constant/solid/mechanicalProperties
solidMesh=../constant/solid/polyMesh

for required in "$materialFile" "$solidMesh"
do
    if [ ! -e "$required" ]
    then
        echo "Not found: $required" >&2
        exit 1
    fi
done

cp "$materialFile" constant/mechanicalProperties
rm -rf constant/polyMesh
cp -a "$solidMesh" constant/polyMesh

if ! grep -Eq "^[[:space:]]*prestress[[:space:]]+[a-z]+;" constant/mechanicalProperties
then
    echo "No 'prestress yes|no;' line in $materialFile" >&2
    exit 1
fi

# Set "prestress yes|no;" in constant/mechanicalProperties. Only a line that
# starts with the keyword is changed, so comments are left alone
setPrestress()
{
    local file=constant/mechanicalProperties
    sed -E "s/^([[:space:]]*prestress[[:space:]]+)[a-z]+;/\1$1;/" \
        "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
}

# Inner-wall pressure in Pa, read by 0/D from constant/timeVsPressure; held
# constant over the single load step of a pass
setPressure()
{
    printf '(\n    (0 %s)\n    (1 %s)\n)\n' "$1" "$1" > constant/timeVsPressure
}

# Pressure of pass $1: min(pass x pressureStep, targetPressure). A product
# within 0.1% of a step of the target is taken as the target, so the rounding
# of the two Pa values cannot add a pass at almost the full pressure
passPressure()
{
    awk -v k="$1" -v s="$pressureStep" -v t="$targetPressure" \
        'BEGIN { p = k * s; if (p >= t - 1e-3 * s) p = t; printf "%.6g", p }'
}

# Passes below the full pressure: ceil(targetPressure / pressureStep) - 1
rampPasses="$(awk -v s="$pressureStep" -v t="$targetPressure" \
    'BEGIN { n = t / s; c = int(n); if (n - c > 1e-3) c++; print (c > 1 ? c - 1 : 0) }')"
totalPasses=$((rampPasses + maxPasses))

# One load step per pass: endTime 1 in system/controlDict
sed -E "s/^([[:space:]]*deltaT[[:space:]]+)[^;]+;/\11;/" \
    system/controlDict > system/controlDict.tmp
mv system/controlDict.tmp system/controlDict

# Run an application in serial or parallel, logging to log.<app>.p<pass>
run()
{
    local pass="$1"
    shift
    if [ "$runParallel" = yes ]
    then
        solids4Foam::runParallel -o -s "p$pass" "$@"
    else
        solids4Foam::runApplication -o -s "p$pass" "$@"
    fi
}

# maxMag(D) of the latest run, column 2 of the last line of prestressHistory
latestMaxD()
{
    awk '$1 !~ /^#/ && NF >= 2 { d = $2 } END { print d }' prestressHistory
}

# Start from no prestress. updatePrestress refuses an Fpre in 0 that the run
# did not use, so any left from an earlier run is removed
rm -rf processor[0-9]* [1-9]* 0.[0-9]*
rm -f 0/Fpre 0/Fpre.gz 0/FprePass* prestressHistory
setPrestress no

if [ "$runParallel" = yes ]
then
    solids4Foam::runApplication -o decomposePar -force
fi

echo "Prestress: $rampPasses ramp pass(es) of $pressureStep Pa, then up to $maxPasses at $targetPressure Pa"

converged=no
fullPasses=0
for pass in $(seq 1 "$totalPasses")
do
    pressure="$(passPressure "$pass")"
    setPressure "$pressure"

    run "$pass" solids4Foam
    if [ "$runParallel" = yes ]
    then
        run "$pass" updatePrestress -parallel
    else
        run "$pass" updatePrestress
    fi

    # Passes after the first apply the Fpre just written
    if [ "$pass" -eq 1 ]
    then
        setPrestress yes
    fi

    maxD="$(latestMaxD)"
    if [ "$pass" -le "$rampPasses" ]
    then
        echo "Prestress pass $pass (ramp, $pressure of $targetPressure Pa): maxMag(D) $maxD m"
        continue
    fi

    fullPasses=$((fullPasses + 1))
    echo "Prestress pass $pass ($fullPasses of at most $maxPasses at $targetPressure Pa): maxMag(D) $maxD m (tolerance $tolerance m)"
    if awk -v d="$maxD" -v t="$tolerance" 'BEGIN { exit !(d != "" && d + 0 < t + 0) }'
    then
        converged=yes
        break
    fi
done

if [ "$runParallel" = yes ]
then
    solids4Foam::runApplication -o reconstructPar -withZero -fields '(Fpre)'
    rm -rf processor[0-9]*
fi

cp 0/Fpre ../0/solid/Fpre

echo "Prestress history (maxMag(D), rmsMag(D) and maxMag(F-I) should fall with each pass at the full pressure):"
cat prestressHistory

if [ "$converged" = yes ]
then
    echo "Prestress converged after $pass pass(es), $fullPasses at the full pressure."
else
    echo "WARNING: prestress did not reach maxMag(D) < $tolerance m in $maxPasses passes at the full pressure." >&2
    echo "The latest Fpre was still copied to ../0/solid/Fpre; check prestressHistory." >&2
    echo "PRESTRESS NOT CONVERGED after $maxPasses passes at $targetPressure Pa: maxMag(D) $maxD m, tolerance $tolerance m" \
        > PRESTRESS_NOT_CONVERGED
fi

#------------------------------------------------------------------------------
