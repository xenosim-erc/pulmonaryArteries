FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          0.25;

writeControl    runTime;

writeInterval   1;

cycleWrite      0;

writeFormat     binary;

writePrecision  6;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

functions
{
    // Integral of D . dS over the inner wall, from which Allprobe works out
    // the lumen volume change and so the compliance of the 3D wall. Allprobe
    // switches it on for its own run only; the prestress passes skip it.
    lumenVolume
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        enabled         false;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
        writeFields     false;
        regionType      patch;
        name            innerWall;
        operation       areaNormalIntegrate;
        fields          (D);
    }
}

