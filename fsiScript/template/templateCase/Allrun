#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Example usage
# ./Allrun
# ./Allrun sonicLiquidFluid
# ./Allrun robin

# This case requires PETSc to be installed
if [ -z "${PETSC_DIR}" ];
then
    echo; echo "Skipping this case as PETSc is not installed"
    echo "Please set the PETSC_DIR variable"; echo
    exit 0
fi


# Source solids4Foam scripts
source solids4FoamScripts.sh

# Check case version is correct
solids4Foam::convertCaseFormat .

# Check fvSolution for foundation version
if [[ $WM_PROJECT = "OpenFOAM" ]] && [[ $WM_PROJECT_VERSION != *"v"* ]]
then
    if [[ -f "${CASE_DIR}"/system/fluid/fvSolution ]]
    then
        echo "OpenFOAM.org specific: replacing 'residualControl' with"
        echo " 'outerCorrectorResidualControl' in system/fluid/fvSolution"
        sed -i "s/residualControl/outerCorrectorResidualControl/g" \
            "${CASE_DIR}"/system/fluid/fvSolution
    fi
fi

### Prestress
# prestress/ computes the prestress Fpre of the imaged wall under the imaging
# pressure and copies it to 0/solid/Fpre; constant/solid/mechanicalProperties
# then has "prestress yes;". meshing.sh leaves prestress/ out, and sets
# "prestress no;", when the case is made with --no-prestress.
if [ -d prestress ]
then
    (cd prestress && ./Allrun parallel)
    if [ ! -f 0/solid/Fpre ]
    then
        echo "0/solid/Fpre missing: prestress/Allrun did not write it." >&2
        exit 1
    fi
fi

### Outlet Windkessel compliance
# The Windkessel compliance from meshing.sh is that measured for the whole
# pulmonary bed, which includes the arteries this case models with a compliant
# wall. When windkessel/settings is present (meshing.sh without
# --no-compliance-correction), prestress/Allprobe measures the compliance of
# the 3D wall, and the outlets are split again with what is left. Until then
# 0/fluid/windkesselOutlets holds the whole-bed split. Only the Python
# standard library is needed; set PYTHON to use another interpreter.
if [ -f windkessel/settings ]
then
    if ! (cd prestress && ./Allprobe parallel)
    then
        echo "prestress/Allprobe failed: the 3D wall compliance is unknown." >&2
        exit 1
    fi
    . windkessel/settings
    wallCompliance="$(awk '$1 !~ /^#/ && NF { v = $1 } END { print v }' prestress/wallCompliance)"
    outletCompliance="$(awk -v c="$wholeBedCompliance" -v w="$wallCompliance" \
        'BEGIN { printf "%.6g", c - w }')"
    if ! awk -v c="$outletCompliance" 'BEGIN { exit !(c + 0 > 0) }'
    then
        echo "The 3D wall compliance ($wallCompliance m^3/Pa) is not less than the" >&2
        echo "whole-bed compliance ($wholeBedCompliance m^3/Pa); not running." >&2
        exit 1
    fi
    echo "Outlet compliance: whole bed $wholeBedCompliance - 3D wall $wallCompliance = $outletCompliance m^3/Pa" \
        > log.windkesselOutlets
    if ! "${PYTHON:-python3}" windkessel/windkessel_outlets.py \
        windkessel/outletAreas.csv 0/fluid/windkesselOutlets \
        --proximal-resistance "$proximalResistance" \
        --distal-resistance "$distalResistance" \
        --compliance "$outletCompliance" \
        --exponent "$flowSplitExponent" \
        --transport-properties constant/fluid/transportProperties \
        --initial-pressure "$initialPressure" \
        ${settledStartWaveform:+--settled-start "$settledStartWaveform" \
            --wall-compliance "$wallCompliance" --wall-pressure "$initialPressure"} \
        >> log.windkesselOutlets 2>&1
    then
        cat log.windkesselOutlets >&2
        echo "Could not split the Windkessel across the outlets." >&2
        exit 1
    fi
    cat log.windkesselOutlets
fi

### Decompose case
# The solid fields are decomposed rather than copied with -copyZero, which
# only suits uniform fields: Fpre differs from cell to cell
solids4Foam::runApplication -s fluid decomposePar -region fluid -copyZero
solids4Foam::runApplication -s solid decomposePar -region solid -force

### Run solver
solids4Foam::runParallel solids4Foam
#solids4Foam

# Recompose case
solids4Foam::runApplication -s fluid reconstructPar -region fluid
solids4Foam::runApplication -s solid reconstructPar -region solid
