#!/bin/bash

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Example usage
# ./Allrun
# ./Allrun sonicLiquidFluid
# ./Allrun robin

# This case requires PETSc to be installed
if [ -z "${PETSC_DIR}" ];
then
    echo; echo "Skipping this case as PETSc is not installed"
    echo "Please set the PETSC_DIR variable"; echo
    exit 0
fi


# Source solids4Foam scripts
source solids4FoamScripts.sh

# Check case version is correct
solids4Foam::convertCaseFormat .

# Check fvSolution for foundation version
if [[ $WM_PROJECT = "OpenFOAM" ]] && [[ $WM_PROJECT_VERSION != *"v"* ]]
then
    if [[ -f "${CASE_DIR}"/system/fluid/fvSolution ]]
    then
        echo "OpenFOAM.org specific: replacing 'residualControl' with"
        echo " 'outerCorrectorResidualControl' in system/fluid/fvSolution"
        sed -i "s/residualControl/outerCorrectorResidualControl/g" \
            "${CASE_DIR}"/system/fluid/fvSolution
    fi
fi

### Prestress
# prestress/ computes the prestress Fpre of the imaged wall under the imaging
# pressure and copies it to 0/solid/Fpre; constant/solid/mechanicalProperties
# then has "prestress yes;". meshing.sh leaves prestress/ out, and sets
# "prestress no;", when the case is made with --no-prestress.
if [ -d prestress ]
then
    (cd prestress && ./Allrun parallel)
    if [ ! -f 0/solid/Fpre ]
    then
        echo "0/solid/Fpre missing: prestress/Allrun did not write it." >&2
        exit 1
    fi
fi

### Decompose case
# The solid fields are decomposed rather than copied with -copyZero, which
# only suits uniform fields: Fpre differs from cell to cell
solids4Foam::runApplication -s fluid decomposePar -region fluid -copyZero
solids4Foam::runApplication -s solid decomposePar -region solid -force

### Run solver
solids4Foam::runParallel solids4Foam
#solids4Foam

# Recompose case
solids4Foam::runApplication -s fluid reconstructPar -region fluid
solids4Foam::runApplication -s solid reconstructPar -region solid
