FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
  processor
    {
      type processor;
    }
  "outlet.*"
    {
      type inletOutlet;// type         fluxCorrectedVelocity;
      value uniform (0 0 0);
      inletValue uniform (0 0 0);
    }
  
    inlet
    {
        type     flowRateInletVelocity;
        // One cardiac cycle of inlet flow rate [m^3/s], repeated. meshing.sh points
        // this at humanFlow or porcine pigFlow in constant/fluid/inletFlow.
        volumetricFlowRate
        {
            type        tableFile;
            file        "<constant>/fluid/inletFlow/humanFlow";
            outOfBounds repeat;
        }
        value    uniform (0 0 0);

    }
    "wall.*"
    {
        // Dirichlet-Neumann approach
      // type         newMovingWallVelocity;
	// value        uniform (0 0 0);

        // Robin-Neumann condition approach
         type         elasticWallVelocity;
         value        uniform (0 0 0);
    }
}

